---
import Layout from '../../components/Layout.astro';
---

<Layout title="Fun">
  <h1 class="text-xl font-semibold text-gray-900">Fun</h1>
  <div class="mt-8">
    <article class="py-5 border-b border-gray-100 last:border-0">
      <a href="/fun/hotpotsauce" class="group">
        <h2 class="text-base font-medium text-gray-900 group-hover:text-gray-500 transition-colors">
          Hot Pot Sauce
        </h2>
      </a>
      <p class="mt-1 text-sm text-gray-500 leading-relaxed">
        Explore hot pot dipping sauce recipes on an interactive flavor map.
      </p>
    </article>
  </div>
</Layout>
