---
interface Props {
  slug: string;
  title: string;
  summary: string;
  stack: string[];
}

const { slug, title, summary, stack } = Astro.props;
---

<article class="py-5 border-b border-gray-100 last:border-0">
  <a href={`/projects/${slug}`} class="group">
    <h2 class="text-base font-medium text-gray-900 group-hover:text-gray-500 transition-colors">
      {title}
    </h2>
  </a>
  <p class="mt-1 text-sm text-gray-500 leading-relaxed">{summary}</p>
  {stack.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-2">
      {stack.map(tag => (
        <span class="text-xs text-gray-400">{tag}</span>
      ))}
    </div>
  )}
</article>
